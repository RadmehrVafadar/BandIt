# Shared server keys for providers a signed-in visitor skips.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# BandIt's public Auth0 settings are built in. To use another tenant, set all three.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=your-spa-client-id
# VITE_AUTH0_AUDIENCE=your-api-identifier
# Optional: preserve the original owner's existing local drawings.
# VITE_AUTH0_OWNER_SUB=google-oauth2|your-original-user-id
